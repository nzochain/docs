{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "NZOChain",
  "description": "Documentação oficial da NZOChain — segurança Web3 não-custodial para utilizadores e API B2B.",
  "colors": {
    "primary": "#00FF88",
    "light": "#66FFAA",
    "dark": "#00C46A"
  },
  "favicon": {
    "light": "/favicon-light.svg",
    "dark": "/favicon.svg"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://nzochain.com"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Abrir app",
      "href": "https://app.nzochain.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/simaodaniel23saymon-design/docs"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "how-it-works",
              "products"
            ]
          },
          {
            "group": "Core Features",
            "pages": [
              "features/risk-score",
              "features/wallet-monitoring",
              "features/contract-analysis",
              "features/permission-revoke"
            ]
          },
          {
            "group": "Supported Networks",
            "pages": [
              "networks/overview",
              "networks/wallet-integrations"
            ]
          },
          {
            "group": "Plans & Pricing",
            "pages": [
              "pricing/individual",
              "pricing/enterprise"
            ]
          },
          {
            "group": "FAQ",
            "pages": ["faq"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "code",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api/overview",
              "api/authentication",
              "api/errors"
            ]
          },
          {
            "group": "API v1",
            "pages": ["api/v1", "api/webhooks"]
          },
          {
            "group": "Legacy / retired",
            "pages": [
              "api/risk-scan",
              "api/wallet-monitor",
              "api/bulk-scan"
            ]
          }
        ]
      }
    ]
  }
}
